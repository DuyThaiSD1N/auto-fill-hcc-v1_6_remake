server {
    listen 12007;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Browser routes /traces/:id luôn quay về bundle Monitor khi tải trực tiếp.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /auth/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Auto test: dịch vụ agent (auto-test-hcc/agents/server.py) chạy trên máy host của người phát triển, ngoài mạng compose.
    # Server production không chạy dịch vụ này → 502 → web tự ẩn nhóm menu Auto test.
    location /agent-api/ {
        set $agent "${AGENT_URL}";
        proxy_pass $agent$request_uri;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
