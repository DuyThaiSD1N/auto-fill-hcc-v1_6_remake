server {
    listen 12008;
    server_name _;

    root /usr/share/nginx/html;
    index lab.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Web Kiểm thử chỉ có một trang: mọi đường dẫn quay về bundle lab.
    location / {
        try_files $uri /lab.html;
    }

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bộ tài liệu đi kèm request /api/v2/process; khớp MAX_TOTAL_PAYLOAD_MB của backend như web quản lý.
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /auth/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
