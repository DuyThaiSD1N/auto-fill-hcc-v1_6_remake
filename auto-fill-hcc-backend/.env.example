# ===== App =====
ENV=production
HOST=0.0.0.0
PORT=8000

# ===== MongoDB (cluster dùng chung callbot) =====
# Cấu hình theo thành phần. Chạy host dùng localhost; docker-compose tự override
# MONGO_HOST=host.docker.internal. (Hoặc set MONGO_URI để dùng thẳng full URI.)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=root
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB=autofill_hcc
# MONGO_URI=        # tuỳ chọn: nếu set sẽ bỏ qua các MONGO_* ở trên

# ===== JWT =====
# sinh secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=change_me_64_hex_chars
JWT_REFRESH_SECRET=change_me_another_64_hex_chars
JWT_ALG=HS256
JWT_ACCESS_TTL=3600          # 1 giờ (giây)
JWT_REFRESH_TTL=2592000      # 30 ngày (giây)

# ===== OCR Tiếng Nói vintern-v12 (provider duy nhất, multipart batch) =====
OCR_TIENGNOI_BASE_URL=https://troly-hcc.tiengnoi.vn
OCR_TIENGNOI_API_KEY=
OCR_TIENGNOI_TIMEOUT_MS=120000
OCR_TIENGNOI_MAX_TOKENS=1500
OCR_TIENGNOI_FILL_MAX_TOKENS=4096

# OCR tiengnoi DỰ PHÒNG — bật khi server chính lỗi. Trống BASE_URL = tắt. API_KEY trống → kế thừa key chính.
FALLBACK_OCR_TIENGNOI_BASE_URL=
FALLBACK_OCR_TIENGNOI_API_KEY=

# Cache OCR
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL_HOURS=12

# ===== LLM primary (vLLM/Qwen, OpenAI-compatible) =====
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# ===== LLM DỰ PHÒNG cấp 1 (mirror vLLM cùng contract) — thử TRƯỚC OpenAI. Trống = tắt. MODEL trống → dùng LLM_MODEL =====
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=

# ===== LLM fallback CUỐI (OpenAI) — dùng khi cả LLM chính lẫn LLM dự phòng lỗi. Để trống = tắt =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Bật reasoning cho agent map (chậm hơn). Mặc định false.
AGENT_REASONING=false

# ===== Upload limits =====
MAX_FILE_SIZE_MB=80
MAX_TOTAL_PAYLOAD_MB=100
# Secret HMAC riêng cho QR upload (64 hex); không dùng chung giữa môi trường.
# python -c "import secrets; print(secrets.token_hex(32))"
UPLOAD_CAPABILITY_SECRET=

# ===== Mobile document session =====
# Origin public của backend, không kèm path. Hai UI dùng /m/autofill và /m/handfree.
MOBILE_BASE_URL=https://trolyhoso-hcc-admin.vnekyc.vn
UPLOAD_SESSION_TTL_MINUTES=30
UPLOAD_SESSION_TTL_HOURS=24
REVIEW_CAPABILITY_TTL_SECONDS=3600
# Scan tài liệu HOSTED của scanic (Trường) — bộ quét CHÍNH trang mobile autofill; local là fallback.
# Trống = tắt hosted (dùng local). Đặt domain để bật. SCANIC_ENABLED=false = kill-switch ép local.
SCANIC_BASE_URL=
SCANIC_ENABLED=true
# Bật entrypoint chat/document-session Handfree sau khi staging qua kiểm thử.
HANDFREE_ENABLED=false
# Rate-limit chat handfree theo TÀI KHOẢN. 0 = tắt hẳn (cao điểm/demo). Nới ở đây khỏi build lại.
CHAT_RATE_MAX=120
CHAT_RATE_WINDOW=60

# ===== Voice Handfree =====
# Để trống URI/token tương ứng = tắt nút mic/loa. WebSocket yêu cầu JWT của extension.
ASR_GRPC_URI=
ASR_GRPC_TOKEN=
ASR_RATE=16000
ASR_SILENCE_TIMEOUT=10
ASR_SPEECH_TIMEOUT=1.8
ASR_SPEECH_MAX=30
TTS_WS_URL=
TTS_API_KEY=
TTS_VOICE=phuongnhi-north
TTS_RESAMPLE_RATE=16000
TTS_TEMPO=0.95
ASR_GRPC_URI_HMONG=
TTS_WS_URL_HMONG=
TTS_VOICE_HMONG=xi

# ===== Batch extraction server-to-server =====
# Sinh riêng, không dùng JWT/secret của tài khoản cán bộ:
# python -c "import secrets; print(secrets.token_hex(32))"
BATCH_API_SECRET=
BATCH_STORAGE_DIR=data/batch
BATCH_WORKER_CONCURRENCY=2
BATCH_MAX_PENDING_ITEMS=5000
BATCH_MAX_ATTEMPTS=3
BATCH_LEASE_SECONDS=600
BATCH_POLL_SECONDS=1
BATCH_MIN_FREE_DISK_MB=1024

# ===== CORS =====
# comma-separated extension id; để rỗng = cho phép mọi chrome-extension:// (chỉ dùng dev)
ALLOWED_EXTENSION_IDS=
# Origin của FE trace (web), phân tách dấu phẩy. Mặc định cho dev Vite.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Backend đích để container FE (nginx, cổng 12006) proxy /api & /auth.
# Trong stack compose dùng tên service: http://app:8000
BACKEND_URL=http://app:8000
