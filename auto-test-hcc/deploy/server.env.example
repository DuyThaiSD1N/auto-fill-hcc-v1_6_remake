# Mẫu auto-test-hcc/server.env cho server production. setup.sh tự chép và điền, file thật đã gitignore.
# Dịch vụ agent đọc file này lúc khởi động (biến đặt sẵn trong môi trường được ưu tiên hơn).
# Không ghi mật khẩu / token / IP nội bộ thật vào file mẫu này (repo dùng chung).

# --- Nguồn req: Mongo + uploads PRODUCTION, chỉ đọc -------------------------------------------------------------------
# Tài khoản Mongo role "read" trên DB production, setup.sh tạo. Có biến này là dịch vụ chạy chế độ server.
AUTOTEST_SOURCE_MONGO_URI=mongodb://autotest_ro:<mat-khau>@127.0.0.1:12004/?authSource=admin
AUTOTEST_SOURCE_DB=autofill_hcc
AUTOTEST_SOURCE_UPLOADS=/opt/autofill-hcc/data/uploads
# Agent không được Read thư mục này dù nằm ngoài repo (.env production, giấy tờ mọi người dân).
AUTOTEST_DENY_READ_DIRS=/opt/autofill-hcc

# --- Kho lưu trữ: req đã bị backend production archive (~30 phút sau lượt cuối) -----------------------------------------
# Tài khoản DỊCH VỤ riêng do đơn vị cấp (chỉ đọc), không dùng tài khoản cá nhân. Thiếu thì Tái hiện lượt / Nội dung đã điền /
# tạo ca chỉ làm được với lượt còn trong Mongo production.
AUTOTEST_ARCHIVE_URL=
AUTOTEST_ARCHIVE_USER=
AUTOTEST_ARCHIVE_PASSWORD=

# --- Khu làm việc: agent sửa trong clone riêng 3 repo thật, đặt đúng tag release đang chạy production ------------------
# Bản clone repo backend (nhánh auto-fix) không có code extension nên luôn bật (setup.sh ghi). Repo private: user chạy dịch vụ
# phải đọc / push được 3 repo (credential helper với token, hoặc đổi sang URL ssh + deploy key có quyền ghi).
AUTOTEST_WORKSPACE=1
# AUTOTEST_BE_GIT_URL=git@github.com:dev-f19/auto-fill-hcc-backend.git
# AUTOTEST_EXT_GIT_URL=git@github.com:dev-f19/auto-fill-hcc-extension.git
# AUTOTEST_TROLY_GIT_URL=git@github.com:dev-f19/tro-ly-nguoi-dan-extension.git
# 0 = bản sửa đạt chỉ nằm trong khu làm việc + fix.patch, không đẩy nhánh agent/<mã ca>.
# AUTOTEST_WORKSPACE_PUSH=1

# --- Backend thử (deploy/compose.server.yml) ---------------------------------------------------------------------------
AUTOTEST_BACKEND=http://127.0.0.1:12015
AUTOTEST_TEST_MONGO_URI=mongodb://127.0.0.1:12014/
AUTOTEST_TEST_DB=autofill_hcc
AUTOTEST_COMPOSE_FILE=/home/autotest/autotest-hcc/auto-test-hcc/deploy/compose.server.yml
AUTOTEST_EXTENSION_BACKEND=http://localhost:12015

# --- Đăng nhập web: super_admin của backend production -----------------------------------------------------------------
AUTOTEST_AUTH_BACKEND=http://127.0.0.1:12005

# --- Kiểu cũ (bản clone monorepo, không khu làm việc): bản sửa đạt → nhánh agent/<mã ca> của remote này ------------------
# AUTOTEST_GIT_REMOTE=origin
AUTOTEST_GIT_NAME=auto-test-hcc agent
AUTOTEST_GIT_EMAIL=auto-test-hcc@localhost

# --- Claude của bạn ----------------------------------------------------------------------------------------------------
# Chạy `claude setup-token` (đăng nhập tài khoản Claude của bạn) rồi dán token vào đây. Chi phí agent tính vào tài khoản đó.
CLAUDE_CODE_OAUTH_TOKEN=
