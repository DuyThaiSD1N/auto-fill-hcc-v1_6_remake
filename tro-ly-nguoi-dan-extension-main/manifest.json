{
  "manifest_version": 3,
  "name": "Trợ lý người dân",
  "version": "1.1",
  "description": "Trợ lý toàn trình hỗ trợ người dân làm thủ tục hành chính công bằng giọng nói và chat, điền hồ sơ tự động từ ảnh giấy tờ.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "unlimitedStorage", "offscreen", "cookies", "browsingData"],
  "host_permissions": [
    "http://localhost:12005/*",
    "ws://localhost:12005/*",
    "https://trolyhoso-hcc.vnekyc.vn/*",
    "wss://trolyhoso-hcc.vnekyc.vn/*",
    "https://trolynguoidan-admin.vnekyc.vn/*",
    "wss://trolynguoidan-admin.vnekyc.vn/*",
    "https://trolyao.tiengnoi.vn/*",
    "wss://trolyao.tiengnoi.vn/*",
    "https://trolynguoidan-dev.tiengnoi.vn/*",
    "wss://trolynguoidan-dev.tiengnoi.vn/*",
    "https://dichvucong.gov.vn/*",
    "https://*.dichvucong.gov.vn/*",
    "https://sso.dancuquocgia.gov.vn/*",
    "https://dichvucongnganhtuphap.moj.gov.vn/*",
    "https://tokhaidientu.moj.gov.vn/*",
    "https://hokinhdoanh.dkkd.gov.vn/*"
  ],
  "action": {
    "default_title": "Trợ lý người dân — bấm để mở trợ lý trên trang",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sso.dancuquocgia.gov.vn/*",
        "https://dichvucongnganhtuphap.moj.gov.vn/*",
        "https://tokhaidientu.moj.gov.vn/*",
        "https://dichvucongbyt.moh.gov.vn/*",
        "https://hokinhdoanh.dkkd.gov.vn/*",
        "https://lienthong.dichvucong.gov.vn/*",
        "https://dichvucong.gov.vn/*",
        "https://*.laichau.gov.vn/*",
        "https://dichvucongbnv.moha.gov.vn/*",
        "https://dichvucong-tthc.moit.gov.vn/*",
        "https://dvc.moc.gov.vn/*",
        "https://dichvucong.bacninh.gov.vn/*",
        "https://dichvucong.ninhbinh.gov.vn/*",
        "https://dichvucong.quangngai.gov.vn/*",
        "https://dichvucong.khanhhoa.gov.vn/*",
        "https://dichvucong.lamdong.gov.vn/*",
        "https://dichvucong.bvhttdl.gov.vn/*",
        "https://dichvucongnnmt.mae.gov.vn/*",
        "https://dichvucong.danang.gov.vn/*",
        "https://dvc.moet.gov.vn/*",
        "https://dichvucong.quangninh.gov.vn/*"
      ],
      "all_frames": true,
      "js": [
        "content/bbox-overlay.js",
        "content/fill-core.js",
        "content/fill-legacy.js",
        "content/fill-angular.js",
        "content/fill-bacninh.js",
        "content/attach-core.js",
        "content/business-registration-adapter.js",
        "content/procedures/business-registration.js",
        "content/portal-dvc.js",
        "content/review.js",
        "content/vneid-sso.js",
        "content.js",
        "content/split-attach.js"
      ],
      "css": ["content/bbox-overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html", "sidebar.css", "sidebar.js",
        "services/*", "api/*", "lib/*", "vendor/*", "assets/*",
        "permission.html", "permission.js"
      ],
      "matches": [
        "https://sso.dancuquocgia.gov.vn/*",
        "https://dichvucongnganhtuphap.moj.gov.vn/*",
        "https://tokhaidientu.moj.gov.vn/*",
        "https://dichvucongbyt.moh.gov.vn/*",
        "https://hokinhdoanh.dkkd.gov.vn/*",
        "https://lienthong.dichvucong.gov.vn/*",
        "https://dichvucong.gov.vn/*",
        "https://*.laichau.gov.vn/*",
        "https://dichvucongbnv.moha.gov.vn/*",
        "https://dichvucong-tthc.moit.gov.vn/*",
        "https://dvc.moc.gov.vn/*",
        "https://dichvucong.bacninh.gov.vn/*",
        "https://dichvucong.ninhbinh.gov.vn/*",
        "https://dichvucong.quangngai.gov.vn/*",
        "https://dichvucong.khanhhoa.gov.vn/*",
        "https://dichvucong.lamdong.gov.vn/*",
        "https://dichvucong.bvhttdl.gov.vn/*",
        "https://dichvucongnnmt.mae.gov.vn/*",
        "https://dichvucong.danang.gov.vn/*",
        "https://dvc.moet.gov.vn/*",
        "https://dichvucong.quangninh.gov.vn/*"
      ]
    }
  ]
}
