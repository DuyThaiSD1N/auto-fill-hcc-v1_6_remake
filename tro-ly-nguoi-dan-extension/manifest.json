{
  "manifest_version": 3,
  "name": "Trợ lý người dân",
  "version": "0.1.0",
  "description": "Trợ lý toàn trình hỗ trợ người dân làm thủ tục hành chính công bằng giọng nói và chat, điền hồ sơ tự động từ ảnh giấy tờ.",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "offscreen"],
  "host_permissions": [
    "https://trolyao.tiengnoi.vn/*",
    "wss://trolyao.tiengnoi.vn/*",
    "https://*.trycloudflare.com/*",
    "wss://*.trycloudflare.com/*",
    "http://160.250.216.27:8010/*",
    "ws://160.250.216.27:8010/*",
    "http://localhost:8010/*",
    "ws://localhost:8010/*"
  ],
  "action": {
    "default_title": "Trợ lý người dân — bấm để mở trợ lý trên trang"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "content/bbox-overlay.js",
        "content/fill-core.js",
        "content/fill-legacy.js",
        "content/fill-angular.js",
        "content/fill-bacninh.js",
        "content/attach-core.js",
        "content/portal-dvc.js",
        "content/review.js",
        "content.js",
        "content/split-attach.js"
      ],
      "css": ["content/bbox-overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html", "sidebar.css", "sidebar.js",
        "services/*", "api/*", "lib/*", "vendor/*", "assets/*",
        "permission.html", "permission.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
