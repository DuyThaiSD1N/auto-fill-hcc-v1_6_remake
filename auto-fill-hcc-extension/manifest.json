{
  "manifest_version": 3,
  "name": "Trợ lý hỗ trợ người dân hoàn thiện thủ tục hành chính",
  "version": "1.15",
  "description": "Hỗ trợ người dân hoàn thiện thủ tục hành chính công",
  "incognito": "spanning",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://trolyhoso-hcc-admin.vnekyc.vn/*"
  ],
  "icons": {
    "16": "assets/icons/hcc-16.png",
    "32": "assets/icons/hcc-32.png",
    "48": "assets/icons/hcc-48.png",
    "128": "assets/icons/hcc-128.png"
  },
  "action": {
    "default_title": "Trợ lý hỗ trợ người dân hoàn thiện thủ tục về Hành chính công",
    "default_icon": {
      "16": "assets/icons/hcc-16.png",
      "32": "assets/icons/hcc-32.png",
      "48": "assets/icons/hcc-48.png",
      "128": "assets/icons/hcc-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dichvucongnganhtuphap.moj.gov.vn/*",
        "https://tokhaidientu.moj.gov.vn/*",
        "https://dichvucongbyt.moh.gov.vn/*",
        "https://hokinhdoanh.dkkd.gov.vn/*",
        "https://dangkyquamang.dkkd.gov.vn/*",
        "https://lienthong.dichvucong.gov.vn/*",
        "https://dichvucong.gov.vn/*",
        "https://*.laichau.gov.vn/*",
        "https://dichvucongbnv.moha.gov.vn/*",
        "https://dichvucong-tthc.moit.gov.vn/*",
        "https://dvc.moc.gov.vn/*",
        "https://dichvucong.bacninh.gov.vn/*",
        "https://dichvucong.quangngai.gov.vn/*",
        "https://dichvucong.khanhhoa.gov.vn/*",
        "https://dichvucong.lamdong.gov.vn/*",
        "https://dichvucong.bvhttdl.gov.vn/*",
        "https://dichvucongnnmt.mae.gov.vn/*",
        "https://dichvucong.danang.gov.vn/*",
        "https://dvc.moet.gov.vn/*",
        "https://dichvucong.quangninh.gov.vn/*"
      ],
      "all_frames": true,
      "js": [
        "api/config.js",
        "content/locations.js",
        "content/bbox-overlay.js",
        "content.js",
        "content/attach-mae.js",
        "content/fill-angular.js",
        "content/fill-liz.js",
        "content/fill-legacy.js",
        "content/fill-bacninh.js",
        "content/procedures/business-registration.js",
        "content/procedures/enterprise-registration.js",
        "content/agency-select.js",
        "content/review.js"
      ],
      "css": [
        "content/bbox-overlay.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dichvucongnnmt.mae.gov.vn/*"
      ],
      "all_frames": true,
      "world": "MAIN",
      "js": [
        "content/attach-mae-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dichvucong.lamdong.gov.vn/*"
      ],
      "all_frames": true,
      "world": "MAIN",
      "js": [
        "content/fill-lamdong-main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "popup-locations.js",
        "changelog.js",
        "api/*",
        "lib/*",
        "vendor/*",
        "assets/icons/*"
      ],
      "matches": [
        "https://dichvucongnganhtuphap.moj.gov.vn/*",
        "https://tokhaidientu.moj.gov.vn/*",
        "https://dichvucongbyt.moh.gov.vn/*",
        "https://hokinhdoanh.dkkd.gov.vn/*",
        "https://dangkyquamang.dkkd.gov.vn/*",
        "https://lienthong.dichvucong.gov.vn/*",
        "https://dichvucong.gov.vn/*",
        "https://*.laichau.gov.vn/*",
        "https://dichvucongbnv.moha.gov.vn/*",
        "https://dichvucong-tthc.moit.gov.vn/*",
        "https://dvc.moc.gov.vn/*",
        "https://dichvucong.bacninh.gov.vn/*",
        "https://dichvucong.quangngai.gov.vn/*",
        "https://dichvucong.khanhhoa.gov.vn/*",
        "https://dichvucong.lamdong.gov.vn/*",
        "https://dichvucong.bvhttdl.gov.vn/*",
        "https://dichvucongnnmt.mae.gov.vn/*",
        "https://dichvucong.danang.gov.vn/*",
        "https://dvc.moet.gov.vn/*",
        "https://dichvucong.quangninh.gov.vn/*"
      ]
    }
  ]
}
