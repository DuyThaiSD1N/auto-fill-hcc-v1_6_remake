server {
    listen 12010;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolver DNS nội bộ của Docker → cho phép proxy_pass dùng biến và resolve
    # lúc request (nginx không crash nếu backend chưa sẵn sàng khi container khởi động).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # SPA: mọi route không phải file tĩnh đều trả về index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API sang backend (envsubst thay ${BACKEND_URL} lúc container khởi động).
    # Dùng biến + $request_uri để DNS resolve runtime và giữ nguyên path/query gốc.
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 110m;  # khớp MAX_TOTAL_PAYLOAD_MB của backend
    }

    location /auth/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket phiên tải ảnh QR (realtime "điện thoại → máy tính"). BẮT BUỘC giữ header
    # Upgrade/Connection để nâng cấp giao thức, nếu không request rơi vào SPA fallback ở trên.
    # Không bật cũng chạy được (extension có poll đối soát 2s), bật thì ảnh về TỨC THÌ.
    location /ws/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;  # WS giữ kết nối lâu, tránh nginx cắt sớm
    }

    # Cache asset có hash trong tên.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
